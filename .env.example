# Run python3 scripts/init_env.py to generate local credentials and config.
# These placeholders are documentation; replace them for manual configuration.
QUEUEPILOT_ENVIRONMENT=development
QUEUEPILOT_APP_NAME=QueuePilot
QUEUEPILOT_DATABASE_URL=postgresql+psycopg://queuepilot:REPLACE_ME@127.0.0.1:55432/queuepilot
QUEUEPILOT_REDIS_URL=redis://127.0.0.1:56379/0
QUEUEPILOT_TOKEN_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
QUEUEPILOT_PROBE_TIMEOUT_SECONDS=2
QUEUEPILOT_WEBSOCKET_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
QUEUEPILOT_AUTH_REQUESTS_PER_MINUTE=30
QUEUEPILOT_READ_REQUESTS_PER_MINUTE=300
QUEUEPILOT_WRITE_REQUESTS_PER_MINUTE=120
QUEUEPILOT_WEBSOCKET_CONNECTION_LIMIT=500
